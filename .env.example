# Billing for the agents your app runs. Separate from your Claude Code subscription.
ANTHROPIC_API_KEY=

# Optional model overrides — see src/config.ts
MODEL_FAST=
MODEL_REASONING=

# Travel data providers. Sort these out before writing the Research agent.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=

# Neon Postgres (CLAUDE.md rule 8 / spec D6/D7). Pooled (-pooler hostname) for
# application queries, direct for migrations (`npm run migrate`) and
# scripts/check-neon.test.ts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
