{
  "name": "voyagemind",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "server": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "test:neon": "vitest run --config vitest.neon.config.ts",
    "eval": "tsx --env-file=.env evals/run.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:frontend",
    "typecheck:server": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.app.json",
    "migrate": "tsx --env-file=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "pg": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
